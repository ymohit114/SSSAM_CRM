{
  "appId": "com.sssam.academy",
  "appName": "SSSAM Portal",
  "webDir": "public",
  "server": {
    "url": "https://sssam-crm.vercel.app",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "Geolocation": {
      "permissions": ["location"]
    },
    "LocalNotifications": {
      "smallIcon": "ic_launcher",
      "iconColor": "#3B82F6",
      "sound": "default"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
